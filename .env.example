# Optional overrides. Compose works without an .env file.
LAB_PORT=5188
# Used only with compose.telemetry.yaml.
TRACE_PORT=16686
# Public demo values, deliberately not production credentials.
LAB_DB_PASSWORD=local-lab-password
LAB_SIGNING_SECRET=local-lab-signing-secret-change-outside-demo
LAB_CONTROL_KEY=local-lab-control-key-change-outside-demo
